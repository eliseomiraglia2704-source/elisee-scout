{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git worktree*)",
      "Bash(git log*)",
      "Bash(node scripts/*)",
      "Bash(powershell*)",
      "Bash(python elisee_up.py*)",
      "Bash(python -m http.server*)"
    ],
    "ask": [
      "Delete",
      "Bash(git push*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy*)",
      "Bash(npm install*)",
      "Bash(npm i*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(data/auth/**)",
      "Read(ssl/**)",
      "Read(~/.ssh/**)",
      "Read(C:/.ssh/**)",
      "Read(C:/Windows/**)",
      "Read(/etc/**)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(data/auth/**)",
      "Edit(ssl/**)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(data/auth/**)",
      "Write(ssl/**)",
      "Edit(eliseo2704/.claude/settings.json)",
      "Write(eliseo2704/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Delete|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-tool-check.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-tool-check.js"
          }
        ]
      }
    ]
  }
}
